// Inline power distribution board: five identical terminals in one row over shared V+ and GND
// planes. Any terminal can be the input and the rest are outputs. No active or passive parts; every
// terminal is a 2-pole WAGO 2601-1102 with pin 1 on V+ and pin 2 on GND.
//
// The same design as PCB/distribution/ (3 x 2 grid of six terminals), laid out in a single row.
// Whichever terminal is the input carries the sum of all the outputs: keep the total within the
// terminal's 17.5 A IEC rating (10 A UL); see PCB/libraries/stackup/parts.kdl.
//
// The four M3 mounting holes and the logo are board-only footprints in the KiCad layout, not parts here.
use "../../libraries/stackup/parts.kdl"

design distribution-inline {
    place wago-2601-1102 "J1" note="Power terminal (input or output)"
    place wago-2601-1102 "J2" note="Power terminal (input or output)"
    place wago-2601-1102 "J3" note="Power terminal (input or output)"
    place wago-2601-1102 "J4" note="Power terminal (input or output)"
    place wago-2601-1102 "J5" note="Power terminal (input or output)"

    circuit "J1.1" "J2.1" "J3.1" "J4.1" "J5.1" name="VPWR"
    circuit "J1.2" "J2.2" "J3.2" "J4.2" "J5.2" name="GND"
}
